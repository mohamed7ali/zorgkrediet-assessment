# Copy to .env and export before starting:
#   set -a; . ./.env; set +a

DATABASE_PATH=./zorgkrediet.sqlite3

# Employee credentials as key:employee_id pairs. Prototype stand-in for real SSO.
EMPLOYEE_API_KEYS=demo-key-1:emp-001,demo-key-2:emp-002

# Optional. Without a key a stub is used and every application with free text is referred to a human.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
